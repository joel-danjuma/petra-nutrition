# The agent's own environment. It holds the model provider keys and a
# read path to the recipe catalogue — no JWT secrets, no SMTP, no Stripe.
NODE_ENV=
AGENT_PORT=

AGENT_DATABASE_URL=

GROQ_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_MODEL_FAST=
GROQ_MODEL_SMART=

# Unset locally: the agent accepts unauthenticated calls in development.
# Required in production, where validateConfig refuses to boot without it.
INTERNAL_API_KEY=

TRANSFORMERS_CACHE=
LOG_LEVEL=

# Redis. Used for two things the agent owns outright: the chat graph's working
# state (TTL'd — the API still owns the durable transcript) and the
# nutrition-database lookup cache. Unset is supported: both fall back to
# in-process memory, which is fine for a single local process.
REDIS_URL=
GRAPH_STATE_TTL_SECONDS=

# USDA FoodData Central, for raw-ingredient macros. Free key, per-key rate
# limited: https://fdc.nal.usda.gov/api-key-signup.html
# Unset is supported — nutrition falls back to model estimates and labels them
# low-confidence rather than presenting a guess as a measurement.
FDC_API_KEY=

# Consult an external recipe source when the local corpus comes up thin.
# Off by default: every hit is a third-party request on a chat turn's critical
# path, and the source currently wired up (TheMealDB) is licensed for
# development and education only. External results seed recipe generation and
# are never recommended, since a recipe with no row cannot be opened.
RECIPE_OVERFLOW_ENABLED=
