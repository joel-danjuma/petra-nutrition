{
  "name": "@petra/agent",
  "version": "1.0.0",
  "description": "Petra AI Agent Service \u2014 chat, retrieval, embeddings and vision",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm run sync-schema && pnpm run db:generate && tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist src/generated",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "sync-schema": "node scripts/sync-schema.mjs",
    "sync-schema:check": "node scripts/sync-schema.mjs --check",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "embed": "tsx src/scripts/embed-recipes.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.11",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@petra/agent-contract": "workspace:*",
    "@petra/food-measures": "workspace:*",
    "@petra/service-kit": "workspace:*",
    "@prisma/client": "^5.2.0",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.5.0",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "groq-sdk": "^0.3.1",
    "helmet": "^7.0.0",
    "ioredis": "^5.11.1",
    "multer": "^2.0.0",
    "prisma": "^5.2.0",
    "sharp": "^0.32.4",
    "winston": "^3.10.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.2",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.5.0",
    "jest": "^29.6.2",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.1.6"
  }
}
