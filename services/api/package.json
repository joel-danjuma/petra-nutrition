{
  "name": "@petra/backend",
  "version": "1.0.0",
  "description": "Petra AI Backend Service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "@petra/shared": "workspace:*",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "multer": "^2.0.0",
    "prisma": "^5.2.0",
    "@prisma/client": "^5.2.0",
    "redis": "^4.6.7",
    "ioredis": "^5.3.2",
    "nodemailer": "^6.9.4",
    "winston": "^3.10.0",
    "dotenv": "^16.3.1",
    "groq-sdk": "^0.3.1",
    "axios": "^1.5.0",
    "sharp": "^0.32.4",
    "uuid": "^11.0.0"
