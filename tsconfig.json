{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@petra/shared/*": [
        "./packages/shared/src/*"
      ],
      "@petra/shared": [
        "./packages/shared/src"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "services/*/src/**/*",
    "apps/*/src/**/*",
    "apps/*/app/**/*",
    "apps/*/types/**/*",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "services/agent/src/generated",
    "dist",
    "build",
    ".next",
    ".expo",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "references": [
    {
      "path": "./packages/shared"
    },
    {
      "path": "./packages/agent-contract"
    },
    {
      "path": "./packages/service-kit"
    },
    {
      "path": "./services/api"
    },
    {
      "path": "./services/agent"
    },
    {
      "path": "./apps/web"
    },
    {
      "path": "./apps/mobile"
    }
  ],
  "extends": "expo/tsconfig.base"
}
