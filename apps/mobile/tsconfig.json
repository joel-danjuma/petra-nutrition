{
  // Expo's base, not the repo root's: SDK 57 sets moduleResolution "bundler"
  // together with customConditions ["react-native"], and TypeScript rejects
  // that pair being split up. The root config targets the Node services and
  // pins moduleResolution to "node", so inheriting from it here produced
  // TS5098 on every build.
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    // Not composite: nothing consumes this package's build output, and marking
    // it so forces every file reached through the @petra/shared path alias to
    // be listed in `include`, which fails for sources in a sibling package.
    "paths": {
      "@/*": ["./src/*"],
      "@petra/shared/*": ["../shared/src/*"],
      "@petra/shared": ["../shared/src"]
    }
  },
  "include": [
    "src/**/*",
    "app/**/*",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".expo",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
