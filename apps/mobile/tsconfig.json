{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowJs": true,
    "jsx": "react-native",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    // Not composite: nothing consumes this package's build output, and marking
    // it so forces every file reached through the @petra/shared path alias to
    // be listed in `include`, which fails for sources in a sibling package.
    "paths": {
      "@/*": ["./src/*"],
      "@petra/shared/*": ["../shared/src/*"],
      "@petra/shared": ["../shared/src"]
    }
  },
  "include": [
    "src/**/*",
    "app/**/*",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".expo",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
