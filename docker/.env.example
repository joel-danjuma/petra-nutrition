# Environment for docker-compose.yml (the full production stack).
# Copy to docker/.env and fill in. Compose reads docker/.env automatically.
#
# Generate secrets with:  openssl rand -hex 32

# ── Required ──────────────────────────────────────────────────────────────
# Compose refuses to start without these two.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# The API refuses to start without these. Each must be at least 32 characters.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Shared secret between the API and the agent. Both refuse to start in
# production without it, and the two must match — compose passes this one
# value to both.
INTERNAL_API_KEY=

# The agent refuses to start without it. Chat and structured extraction.
GROQ_API_KEY=

# ── Agent ─────────────────────────────────────────────────────────────────
# Gemini Pro Vision, for the pantry photo scan and receipt scanning.
GEMINI_API_KEY=

# USDA FoodData Central, for raw-ingredient macros. Free key:
# https://fdc.nal.usda.gov/api-key-signup.html
# Unset means nutrition falls back to labelled low-confidence estimates.
FDC_API_KEY=

# Defaults to the postgres superuser. Better: a role with SELECT on the recipe
# tables and DML on recipe_embeddings only.
# AGENT_DATABASE_URL=postgresql://petra_agent:CHANGE_ME@postgres:5432/petra_ai

# Model availability is per-account; check with
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# GROQ_MODEL_FAST=openai/gpt-oss-20b
# GROQ_MODEL_SMART=openai/gpt-oss-120b

# GRAPH_STATE_TTL_SECONDS=3600
# RECIPE_OVERFLOW_ENABLED=false

# ── Email (verification and password reset) ───────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=Petra AI

# ── Web ───────────────────────────────────────────────────────────────────
# Set these to the public URLs once the stack is behind a domain.
# CORS_ORIGINS=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:3001/api
# NEXT_PUBLIC_WEB_URL=http://localhost:3000
